# ══════════════════════════════════════════════════════════════════════
# Chatwoot Cloud — Clube TCL SEMP 2026 · Agência YBY
# Variáveis para usar com app.chatwoot.com (plano gratuito)
#
# Copiar para .env.local do portal Next.js
# ══════════════════════════════════════════════════════════════════════

# ── Base URL do Chatwoot ─────────────────────────────────────────────
# Cloud (free)
NEXT_PUBLIC_CHATWOOT_BASE_URL=https://app.chatwoot.com
CHATWOOT_BASE_URL=https://app.chatwoot.com

# Self-hosted (quando o servidor estiver no ar)
# NEXT_PUBLIC_CHATWOOT_BASE_URL=https://bko.ybyagencia.com.br
# CHATWOOT_BASE_URL=https://bko.ybyagencia.com.br

# ── Tokens dos Inboxes ───────────────────────────────────────────────
# Preencher após criar os inboxes em Settings → Inboxes → (inbox) → Settings → Configuration

# Inbox "Chat Web SEMP TCL" (cor #E30613)
NEXT_PUBLIC_CHATWOOT_TOKEN_SEMP=PREENCHER_APOS_CRIAR_INBOX_SEMP

# Inbox "Chat Web PRO TCL" (cor #1A6FA8)
NEXT_PUBLIC_CHATWOOT_TOKEN_PRO=PREENCHER_APOS_CRIAR_INBOX_PRO

# ── API Token (para N8N / integrações server-side) ───────────────────
# Obtido em: Profile → Access Token
CHATWOOT_API_TOKEN=PREENCHER_COM_ACCESS_TOKEN_DO_PERFIL

# ── Account ID ───────────────────────────────────────────────────────
# Obtido na URL do painel: app.chatwoot.com/app/accounts/{ACCOUNT_ID}/
CHATWOOT_ACCOUNT_ID=PREENCHER_COM_SEU_ACCOUNT_ID

# ── IDs de Inboxes (para N8N handoff) ────────────────────────────────
# Obtido em Settings → Inboxes → (inbox) → Settings → URL (id=XXX)
CHATWOOT_INBOX_SEMP_ID=PREENCHER
CHATWOOT_INBOX_PRO_ID=PREENCHER

# ── IDs de Times (para N8N handoff) ──────────────────────────────────
# Obtido em Settings → Teams
CHATWOOT_TEAM_SEMP_ID=PREENCHER
CHATWOOT_TEAM_PRO_ID=PREENCHER
